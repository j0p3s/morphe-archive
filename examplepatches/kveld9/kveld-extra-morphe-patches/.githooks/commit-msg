#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

commit_msg_file="${1:-}"

if [[ -z "$commit_msg_file" || ! -f "$commit_msg_file" ]]; then
    echo "Error: commit message file not provided or not found" >&2
    exit 1
fi

first_line=$(head -n 1 "$commit_msg_file")

if [[ -z "$first_line" ]]; then
    echo "Error: commit title is empty" >&2
    exit 1
fi

if [[ ${#first_line} -gt 72 ]]; then
    echo "Error: commit title exceeds 72 characters (${#first_line} characters)" >&2
    exit 1
fi

if LC_ALL=C grep -q '[^[:cntrl:][:print:]]' "$commit_msg_file" || [[ "$first_line" =~ [^[:cntrl:][:print:]] ]]; then
    echo "Error: commit message contains non-ASCII characters" >&2
    exit 1
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?(!)?: .+'
if [[ ! "$first_line" =~ $pattern ]]; then
    echo "Error: commit title does not match Conventional Commits format" >&2
    exit 1
fi
