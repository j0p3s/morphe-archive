#!/usr/bin/env bash
# post-commit: propagate canonical shared skills to the mirror repo.
# Enabled per clone with: git config core.hooksPath scripts/hooks
# The file must be executable.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$ROOT/scripts/sync_shared_skills.sh"
[ -x "$SCRIPT" ] || exit 0

"$SCRIPT" --hook || true
